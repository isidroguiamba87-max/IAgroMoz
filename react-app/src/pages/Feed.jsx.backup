import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import MobileNav from '../components/MobileNav'
import LoadingPlant from '../components/LoadingPlant'
import Logo from '../components/Logo'
import Comment from '../components/Comment'
import api from '../services/api'

function Feed() {
  const navigate = useNavigate()
  const [posts, setPosts] = useState([])
  const [loading, setLoading] = useState(true)
  const [likedPosts, setLikedPosts] = useState(new Set())
  
  // Estados para comentários expandidos
  const [expandedComments, setExpandedComments] = useState({})
  const [commentTexts, setCommentTexts] = useState({})
  const [loadingComments, setLoadingComments] = useState({})
  const [postComments, setPostComments] = useState({})
  
  // Estados para modais
  const [showLikesModal, setShowLikesModal] = useState(null)
  const [showShareModal, setShowShareModal] = useState(null)

  useEffect(() => {
    loadPosts()
  }, [])

  const loadPosts = async () => {
    try {
      setLoading(true)
      const data = await api.getQuestions()
      setPosts(data)
    } catch (err) {
      console.error('Erro ao carregar posts:', err)
      // Dados de exemplo quando API não está disponível
      setPosts([
        {
          id: 1,
          title: 'Colheita de Tomates Orgânicos 🍅',
          body: 'Acabei de colher meus tomates orgânicos! Foram 3 meses de cuidado e o resultado foi incrível. Usei apenas compostagem e controle biológico de pragas.',
          author_name: 'João Silva',
          created_at: new Date().toISOString(),
          answers_count: 5,
          likes_count: 12,
          image: null,
          is_product_available: true,
          linked_product: 1,
          product_id: 1,
          product_name: 'Tomates Orgânicos',
          answers: [
            {
              id: 101,
              body: 'Parabéns pela colheita! Quanto tempo levou?',
              author_name: 'Maria Costa',
              created_at: new Date(Date.now() - 3600000).toISOString(),
              replies: []
            },
            {
              id: 102,
              body: 'Ficaram lindos! Você vende?',
              author_name: 'Carlos Nhantumbo',
              created_at: new Date(Date.now() - 7200000).toISOString(),
              replies: []
            }
          ]
        },
        {
          id: 2,
          title: 'Dúvida sobre Irrigação por Gotejamento',
          body: 'Estou pensando em implementar irrigação por gotejamento na minha horta. Alguém tem experiência? Vale a pena o investimento?',
          author_name: 'Maria Costa',
          created_at: new Date(Date.now() - 3600000).toISOString(),
          answers_count: 12,
          likes_count: 8,
          image: null,
          is_product_available: false,
          answers: []
        },
        {
          id: 3,
          title: 'Sementes de Milho Híbrido Disponíveis! 🌽',
          body: 'Tenho sementes de milho híbrido de alta produtividade. Resistente a pragas e adaptado ao clima de Moçambique. Rendimento médio de 8-10 toneladas por hectare.',
          author_name: 'Carlos Nhantumbo',
          created_at: new Date(Date.now() - 7200000).toISOString(),
          answers_count: 8,
          likes_count: 25,
          image: null,
          is_product_available: true,
          linked_product: 2,
          product_id: 2,
          product_name: 'Sementes de Milho Híbrido',
          answers: []
        }
      ])
    } finally {
      setLoading(false)
    }
  }

  const handleLike = (postId) => {
    setLikedPosts(prev => {
      const newLiked = new Set(prev)
      if (newLiked.has(postId)) {
        newLiked.delete(postId)
      } else {
        newLiked.add(postId)
      }
      return newLiked
    })
  }

  const toggleComments = async (postId) => {
    if (expandedComments[postId]) {
      // Fechar comentários
      setExpandedComments(prev => ({ ...prev, [postId]: false }))
    } else {
      // Abrir comentários
      setExpandedComments(prev => ({ ...prev, [postId]: true }))
      
      // Carregar comentários se ainda não foram carregados
      if (!postComments[postId]) {
        try {
          setLoadingComments(prev => ({ ...prev, [postId]: true }))
          const post = await api.getQuestion(postId)
          setPostComments(prev => ({ ...prev, [postId]: post.answers || [] }))
        } catch (err) {
          console.error('Erro ao carregar comentários:', err)
          // Usar comentários de exemplo do post
          const post = posts.find(p => p.id === postId)
          setPostComments(prev => ({ ...prev, [postId]: post?.answers || [] }))
        } finally {
          setLoadingComments(prev => ({ ...prev, [postId]: false }))
        }
      }
    }
  }

  const handleSubmitComment = async (postId, e) => {
    e?.preventDefault()
    const text = commentTexts[postId]
    if (!text?.trim()) return

    try {
      await api.createAnswer(postId, text, null)
      setCommentTexts(prev => ({ ...prev, [postId]: '' }))
      
      // Recarregar comentários
      const post = await api.getQuestion(postId)
      setPostComments(prev => ({ ...prev, [postId]: post.answers || [] }))
      
      // Atualizar contador no post
      setPosts(prev => prev.map(p => 
        p.id === postId ? { ...p, answers_count: post.answers?.length || 0 } : p
      ))
    } catch (err) {
      console.error('Erro ao enviar comentário:', err)
      alert('Erro ao enviar comentário. Faça login primeiro.')
    }
  }

  const handleReply = async (postId, parentId, replyText) => {
    try {
      await api.createAnswer(postId, replyText, parentId)
      
      // Recarregar comentários
      const postData = await api.getQuestion(postId)
      setPostComments(prev => ({ ...prev, [postId]: postData.answers || [] }))
    } catch (err) {
      console.error('Erro ao enviar resposta:', err)
      alert('Erro ao enviar resposta. Faça login primeiro.')
    }
  }

  const handleShowLikes = (postId) => {
    setShowLikesModal(postId)
  }

  const handleShare = (postId) => {
    setShowShareModal(postId)
  }

  const shareToWhatsApp = (post) => {
    const text = `${post.title}\n\n${post.body}\n\nVia IAgroMOZ`
    const url = `https://wa.me/?text=${encodeURIComponent(text)}`
    window.open(url, '_blank')
    setShowShareModal(null)
  }

  const shareToFacebook = (post) => {
    const url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(window.location.href)}`
    window.open(url, '_blank')
    setShowShareModal(null)
  }

  const shareToTwitter = (post) => {
