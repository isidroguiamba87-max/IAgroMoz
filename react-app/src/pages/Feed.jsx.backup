            <Logo size="md" showText={true} />
            
            <button className="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center click-scale">
              <span className="text-xl">🔔</span>
            </button>
          </div>
        </div>
      </header>

      {/* Content */}
      <main className="max-w-2xl mx-auto px-4 py-6">
        {/* Banner Modo Demonstração */}
        <div className="bg-blue-50 border-2 border-blue-200 rounded-xl p-4 mb-6">
          <div className="flex items-start gap-3">
            <span className="text-2xl">ℹ️</span>
            <div>
              <p className="font-semibold text-blue-800 mb-1">Modo Demonstração</p>
              <p className="text-sm text-blue-700">
                Você está vendo dados de exemplo. Para salvar posts reais, inicie o backend Django:
              </p>
              <code className="text-xs bg-blue-100 px-2 py-1 rounded mt-2 inline-block">
                cd backend && python manage.py runserver
              </code>
            </div>
          </div>
        </div>

        {/* Create Post */}
        <div className="agro-card p-4 mb-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-full bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center text-white font-bold">
              U
            </div>
            <input
              type="text"
              placeholder="Compartilhe sua experiência agrícola..."
              className="flex-1 bg-gray-50 border border-gray-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 click-scale"
              onClick={() => navigate('/create-post')}
              readOnly
            />
          </div>
        </div>

        {/* Posts */}
        {loading ? (
          <LoadingPlant />
        ) : posts.length === 0 ? (
          <div className="text-center py-12">
            <p className="text-gray-500 mb-4">Nenhum post ainda</p>
            <button 
              onClick={() => navigate('/create-post')}
              className="btn-primary text-white px-6 py-3 rounded-xl"
            >
              Criar primeiro post
            </button>
          </div>
        ) : (
          <div>
            {posts.map(post => {
              const isLiked = likedPosts.has(post.id)
              const likesCount = (post.likes_count || 0) + (isLiked ? 1 : 0)
              const commentsExpanded = expandedComments[post.id]
              const comments = postComments[post.id] || []
              const mainComments = comments.filter(c => !c.parent)
              
              return (
                <div key={post.id} className="agro-card mb-4 soil-texture">
                  {/* Autor e Data no Topo */}
                  <div className="p-4 pb-0">
                    <div className="flex items-center justify-between mb-3">
                      <div className="flex items-center gap-3">
                        <div className="w-10 h-10 rounded-full bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center text-white font-bold">
                          {post.author_name?.charAt(0).toUpperCase() || 'U'}
                        </div>
                        <div>
                          <p className="font-semibold text-gray-800">{post.author_name || 'Usuário'}</p>
                          <p className="text-xs text-gray-500">
                            {new Date(post.created_at).toLocaleDateString('pt-BR')}
                          </p>
                        </div>
                      </div>
                      <div className="region-badge">
                        <span>📍</span>
                        <span>Comunidade</span>
                      </div>
                    </div>

                    {/* Título e Corpo */}
                    <h3 className="text-lg font-bold text-gray-800 mb-2">{post.title}</h3>
                    <p className="text-gray-600 text-sm mb-3 whitespace-pre-wrap">{post.body}</p>
                  </div>

                  {/* Imagem do Post */}
                  {post.image && (
                    <img 
                      src={post.image} 
                      alt={post.title}
                      className="w-full h-64 object-cover"
                    />
                  )}

                  {/* Badge de Produto Disponível */}
                  {post.is_product_available && post.linked_product && (
                    <div className="px-4 pt-3">
                      <button
                        onClick={() => navigate(`/product/${post.product_id}`)}
                        className="inline-flex items-center gap-2 bg-green-100 hover:bg-green-200 text-green-700 px-4 py-2 rounded-full text-sm font-semibold click-scale"
                      >
                        <span>🛒</span>
                        <span>Disponível no Mercado: {post.product_name}</span>
                        <span>→</span>
                      </button>
                    </div>
                  )}

                  {/* Estatísticas (Curtidas e Comentários) */}
                  <div className="px-4 pt-3 pb-2">
                    <div className="flex items-center justify-between text-sm text-gray-600">
                      <button 
                        onClick={() => handleShowLikes(post.id)}
                        className="flex items-center gap-1 hover:underline"
                      >
                        {likesCount > 0 && (
                          <>
                            <span className="text-blue-600">👍</span>
                            <span>{likesCount}</span>
                          </>
                        )}
                      </button>
                      <div className="flex items-center gap-3">
                        {post.answers_count > 0 && (
                          <button 
                            onClick={() => toggleComments(post.id)}
                            className="hover:underline"
                          >
                            {post.answers_count} {post.answers_count === 1 ? 'comentário' : 'comentários'}
                          </button>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* Barra de Interações (Gostar, Comentar, Partilhar) */}
                  <div className="border-t border-gray-200 px-2 py-1">
                    <div className="flex items-center justify-around">
                      <button
                        onClick={() => handleLike(post.id)}
                        className={`flex-1 flex items-center justify-center gap-2 py-2 rounded-lg hover:bg-gray-100 transition-colors click-scale ${
                          isLiked ? 'text-blue-600 font-semibold' : 'text-gray-600'
                        }`}
                      >
                        <span className="text-xl">{isLiked ? '👍' : '👍🏽'}</span>
                        <span className="text-sm font-medium">Gostar</span>
                      </button>

                      <button
                        onClick={() => toggleComments(post.id)}
                        className="flex-1 flex items-center justify-center gap-2 py-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-600 click-scale"
                      >
                        <span className="text-xl">💬</span>
                        <span className="text-sm font-medium">Comentar</span>
                      </button>

                      <button
                        onClick={() => handleShare(post.id)}
                        className="flex-1 flex items-center justify-center gap-2 py-2 rounded-lg hover:bg-gray-100 transition-colors text-gray-600 click-scale"
                      >
                        <span className="text-xl">↗️</span>
                        <span className="text-sm font-medium">Partilhar</span>
                      </button>
                    </div>
                  </div>

                  {/* Seção de Comentários Expandida */}
                  {commentsExpanded && (
                    <div className="border-t border-gray-200 bg-gray-50">
                      {/* Campo para Novo Comentário */}
                      <div className="px-4 py-3">
                        <form onSubmit={(e) => handleSubmitComment(post.id, e)} className="flex items-center gap-2">
                          <div className="w-8 h-8 rounded-full bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                            U
                          </div>
                          <input
                            type="text"
                            value={commentTexts[post.id] || ''}
                            onChange={(e) => setCommentTexts(prev => ({ ...prev, [post.id]: e.target.value }))}
                            placeholder="Escreva um comentário..."
                            className="flex-1 bg-white border border-gray-300 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600"
                          />
                        </form>
                      </div>

                      {/* Lista de Comentários */}
                      <div className="px-4 pb-4 max-h-96 overflow-y-auto">
                        {loadingComments[post.id] ? (
                          <div className="text-center py-4">
                            <LoadingPlant />
                          </div>
                        ) : mainComments.length > 0 ? (
                          <div className="space-y-1">
                            {mainComments.map(comment => (
                              <Comment
                                key={comment.id}
                                comment={comment}
                                onReply={(parentId, replyText) => handleReply(post.id, parentId, replyText)}
                                depth={0}
                              />
                            ))}
                          </div>
                        ) : (
                          <div className="text-center py-4">
                            <p className="text-gray-500 text-sm">Nenhum comentário ainda. Seja o primeiro!</p>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        )}
      </main>

      {/* Modal de Curtidas */}
      {showLikesModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4" onClick={() => setShowLikesModal(null)}>
          <div className="bg-white rounded-2xl max-w-md w-full max-h-96 overflow-hidden" onClick={(e) => e.stopPropagation()}>
            <div className="p-4 border-b border-gray-200 flex items-center justify-between">
              <h3 className="font-bold text-lg">Pessoas que gostaram</h3>
              <button onClick={() => setShowLikesModal(null)} className="text-gray-500 hover:text-gray-700">
                ✕
              </button>
            </div>
            <div className="overflow-y-auto max-h-80">
              {getLikesList(showLikesModal).map((name, index) => (
                <div key={index} className="p-3 hover:bg-gray-50 flex items-center gap-3">
                  <div className="w-10 h-10 rounded-full bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center text-white font-bold">
                    {name.charAt(0)}
                  </div>
                  <span className="font-medium text-gray-800">{name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* Modal de Partilhar */}
      {showShareModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-end sm:items-center justify-center" onClick={() => setShowShareModal(null)}>
          <div className="bg-white rounded-t-3xl sm:rounded-2xl max-w-md w-full" onClick={(e) => e.stopPropagation()}>
            <div className="p-4 border-b border-gray-200">
              <div className="w-12 h-1 bg-gray-300 rounded-full mx-auto mb-4 sm:hidden"></div>
              <h3 className="font-bold text-lg text-center">Partilhar</h3>
            </div>
            <div className="p-4">
              {(() => {
                const post = posts.find(p => p.id === showShareModal)
                return (
                  <>
                    <button
                      onClick={() => shareToOwnProfile(showShareModal)}
                      className="w-full flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors"
                    >
                      <div className="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                        <span className="text-2xl">📝</span>
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-gray-800">Partilhar no seu perfil</p>
                        <p className="text-xs text-gray-500">Compartilhe com seus seguidores</p>
                      </div>
                    </button>

                    <button
                      onClick={() => shareToWhatsApp(post)}
                      className="w-full flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors"
                    >
                      <div className="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                        <span className="text-2xl">📱</span>
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-gray-800">WhatsApp</p>
                        <p className="text-xs text-gray-500">Enviar via WhatsApp</p>
                      </div>
                    </button>

                    <button
                      onClick={() => shareToFacebook(post)}
                      className="w-full flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors"
                    >
                      <div className="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                        <span className="text-2xl">👥</span>
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-gray-800">Facebook</p>
                        <p className="text-xs text-gray-500">Partilhar no Facebook</p>
                      </div>
                    </button>

                    <button
                      onClick={() => shareToTwitter(post)}
                      className="w-full flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors"
                    >
                      <div className="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                        <span className="text-2xl">🐦</span>
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-gray-800">Twitter / X</p>
                        <p className="text-xs text-gray-500">Partilhar no Twitter</p>
                      </div>
                    </button>

                    <button
                      onClick={() => copyLink(showShareModal)}
                      className="w-full flex items-center gap-4 p-3 hover:bg-gray-50 rounded-xl transition-colors"
                    >
                      <div className="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center">
                        <span className="text-2xl">🔗</span>
                      </div>
                      <div className="text-left">
                        <p className="font-semibold text-gray-800">Copiar link</p>
                        <p className="text-xs text-gray-500">Copiar link do post</p>
                      </div>
                    </button>
                  </>
                )
              })()}
            </div>
            <div className="p-4 border-t border-gray-200">
              <button
                onClick={() => setShowShareModal(null)}
                className="w-full py-3 text-gray-600 font-semibold hover:bg-gray-50 rounded-xl transition-colors"
              >
                Cancelar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Mobile Navigation */}
      <MobileNav />
    </div>
  )
}

export default Feed
