{
  "buildCommand": "cd react-app && npm install && npm run build",
  "outputDirectory": "react-app/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.iagromoz.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://api.iagromoz.com/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
